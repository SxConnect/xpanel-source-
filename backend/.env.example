# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://xpanel:xpanel@localhost:5432/xpanel?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin (primeiro usuário)
ADMIN_EMAIL=admin@xpanel.local
ADMIN_PASSWORD=admin123

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Traefik
TRAEFIK_NETWORK=traefik-public
TRAEFIK_DASHBOARD_PORT=8080

# ConnectAI Integration (opcional)
CONNECTAI_ENABLED=false
CONNECTAI_URL=http://localhost:3000

# Central SX Connect
CENTRAL_API_URL=https://central.sxconnect.com
CENTRAL_API_KEY=

# Email (Postfix/Dovecot)
EMAIL_DOMAIN=mail.xpanel.local
EMAIL_ADMIN=admin@xpanel.local

# Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Logs
LOG_LEVEL=info
LOG_FILE=logs/xpanel.log
