{
    "name": "@sxconnect/xpanel-backend",
    "version": "0.1.0",
    "description": "XPanel - Backend API",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "xpanel",
        "hosting",
        "docker",
        "vps",
        "control-panel"
    ],
    "author": "SX Connect",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "dotenv": "^16.4.5",
        "zod": "^3.22.4",
        "@prisma/client": "^5.9.1",
        "bcrypt": "^5.1.1",
        "jsonwebtoken": "^9.0.2",
        "winston": "^3.11.0",
        "axios": "^1.6.7",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.19",
        "@types/cors": "^2.8.17",
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/uuid": "^9.0.8",
        "typescript": "^5.3.3",
        "tsx": "^4.7.1",
        "prisma": "^5.9.1",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "prettier": "^3.2.5"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}